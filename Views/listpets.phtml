// Generate a random token and store in session for AJAX security
$token = substr(str_shuffle(MD5(microtime())), 0, 20);
$_SESSION['ajaxToken'] = $token;
?>

    <script>
        /**
         * LiveSearch class - handles real-time pet search via AJAX.
         * Sends a request to the search API on each keystroke and renders results.
         */
        class LiveSearch {
            /**
             * Constructor - sets up the search input listener and result container.
             * @param {string} inputId - The ID of the search input element.
             * @param {string} resultsId - The ID of the results container element
             * @param {string} apiUrl - The URL of the search API endpoint.
             */
            constructor(inputId, resultsId, apiUrl) {
                this.apiUrl = apiUrl;
                this.resultsContainer = document.getElementById(resultsId);
                this.debounceTimer = null;

                // Attach keyup event listener to the search input
                document.getElementById(inputId).addEventListener('keyup', (e) => {
                    this.onKeyUp(e.target.value);
                });
            }
            /**
             * Handles keyup events with debouncing to avoid excessive API calls.
             * Waits 300ms after the user stops typing before sending the request.
             * @param {string} searchTerm - The current value of the search input.
             */
            onKeyUp(searchTerm) {
                // Clear the previous timer to debounce rapid keystroked
                clearTimeout(this.debounceTimer);

                // Clear the results if the search box is empty
                if (searchTerm.trim() === '') {
                    this.resultsContainer.innerHTML = '';
                    this.resultsContainer.style.display = 'none';
                    return;
                }

                // Wait for 300ms(0.3s) before sending the AJAX request
                this.debounceTimer = setTimeout(() => {
                    this.search(searchTerm.trim());
                }, 300);
            }
            /**
             * Sends an AJAX GET request to the search API with the given searchTerm.
             * @param {string} searchTerm - The search term to send to the API.
             */
            search(searchTerm) {
                var xhr = new XMLHttpRequest();
                xhr.open('GET', this.apiUrl + '?searchTerm=' + encodeURIComponent(searchTerm) + '&token=<?php echo $token; ?>', true);
                xhr.send();

                // Handle the response when it arrives
                xhr.onreadystatechange = () => {
                    if (xhr.readyState === 4 && xhr.status == 200) {
                        var pets = JSON.parse(xhr.responseText);
                        this.renderDropdown(pets);
                    }
                };
            }

            /**
             * Renders matching pets as a dropdown list below the search input.
             * @param {Array} pets - Array of pet objects from the API.
             */
            renderDropdown(pets) {
                this.resultsContainer.innerHTML = '';

                // Hide if no results
                if (pets.length === 0) {
                    this.resultsContainer.style.display = 'none';
                    return;
                }

                // Build a list item for each matching pet
                pets.slice(0, 8).forEach((pet) => {
                    var item = document.createElement('div');
                    item.style.cssText = 'padding:10px 14px; cursor:pointer; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; gap:10px;';

                    var statusBadge = pet.status === 'lost'
                        ? '<span class="badge bg-danger" style="font-size:10px;">Lost</span>'
                        : '<span class="badge bg-success" style="font-size:10px;">Found</span>';

                    item.innerHTML = `<img src="${pet.photo_url}" style="width:40px;height:40px;object-fit:cover;border-radius:4px;">
                    <div>
                        <strong>${pet.name}</strong> ${statusBadge}
                        <span class="badge bg-info" style="font-size:10px;">${pet.species}</span>
                        <br><small class="text-muted">${pet.breed}</small>
                    </div>`;

                    // Clicking a suggestion fills the search box and submits the form
                    item.addEventListener('click', () => {
                        document.getElementById('search').value = pet.name;
                        this.resultsContainer.style.display = 'none';
                        document.querySelector('form').submit();
                    });

                    item.addEventListener('mouseover', () => { item.style.background = '#f8f9fa'; });
                    item.addEventListener('mouseout', () => { item.style.background = 'white'; });

                    this.resultsContainer.appendChild(item);
                });

                // Show the dropdown
                this.resultsContainer.style.display = 'block';
            }
        }
        // Initialise the LiveSearch when the page loads
        var liveSearch = new LiveSearch('search', 'live-results', 'apisearch.php');
    </script>
